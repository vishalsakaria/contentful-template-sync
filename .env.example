# Contentful organization that owns the content model template(s)
CONTENTFUL_ORG_ID=
# The one source space/environment the content model is edited in
SOURCE_SPACE_ID=
SOURCE_ENVIRONMENT_ID=master
# Comma-separated template IDs to keep in sync (the dashboard shows the first by default)
TEMPLATE_IDS=
# Organization-level Content Management API token (secret)
CONTENTFUL_CMA_TOKEN=
# OPTIONAL. Leave blank to skip webhook signature checks (fine for a PoC). If you enable
# "request verification" in Contentful, paste its signing secret here (secret)
CONTENTFUL_WEBHOOK_SECRET=
# additive-only | all | manual
#   additive-only: additive changes roll out automatically, breaking changes create the version but hold rollout
#   all:           every change rolls out automatically (breaking changes will likely fail validation)
#   manual:        never roll out automatically; use the dashboard's "Install latest" button
AUTO_INSTALL_MODE=additive-only
# Shared password protecting the dashboard and POST routes (secret)
DASHBOARD_PASSWORD=
